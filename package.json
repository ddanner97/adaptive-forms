{
  "name": "@ddanner97/adaptive-forms",
  "version": "0.1.1",
  "description": "Config-driven multi-step form engine and UI primitives for React. Headless core, optional Tailwind preset.",
  "license": "MIT",
  "author": "Damian Danner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddanner97/adaptive-forms.git"
  },
  "homepage": "https://github.com/ddanner97/adaptive-forms#readme",
  "bugs": {
    "url": "https://github.com/ddanner97/adaptive-forms/issues"
  },
  "keywords": [
    "react",
    "form",
    "multi-step",
    "wizard",
    "react-hook-form",
    "tailwind",
    "headless"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./forms": "./src/forms/index.ts",
    "./fields": "./src/fields/index.ts",
    "./dialogs": "./src/dialogs/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^27.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
